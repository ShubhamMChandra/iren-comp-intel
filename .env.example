# Optional: AI features (summaries, briefs, classification). Leave unset for keyword fallbacks.
# OPENROUTER_API_KEY=sk-or-...

# Optional: override DB path (default: data/iren_intel.db)
# DATABASE_URL=sqlite:///./data/iren_intel.db

# Optional: SEC EDGAR requests (identify your app)
# SEC_EDGAR_USER_AGENT=IrenIntel your@email.com

# Optional: verbose logging (API: DEBUG level)
# LOG_LEVEL=DEBUG
# VERBOSE=1

# Optional: Parallel Web SDK key (prospect discovery scripts)
# PARALLEL_API_KEY=

# Optional: GitHub token (CI, release automation)
# GITHUB_TOKEN=

# --- Railway (production) ---
# Set these in the Railway service environment variables dashboard:
#
# DATABASE_URL=sqlite:////data/iren_intel.db   ← points at the mounted volume
# CORS_ORIGINS=https://your-app.vercel.app
# OPENROUTER_API_KEY=sk-or-...
